# ============================================================
# ChlorisGarden - Root Environment Template
# ============================================================
# File ini adalah template environment variable untuk kebutuhan
# root repository ChlorisGarden.
#
# Cara pakai:
# 1. Rename file ini menjadi .env.example jika perlu.
# 2. Copy .env.example menjadi .env
#    cp .env.example .env
# 3. Isi value sesuai environment lokal/deployment.
# 4. Jangan commit file .env asli ke GitHub.
# ============================================================


# ============================================================
# APP CONFIG
# ============================================================
APP_NAME=ChlorisGarden
APP_ENV=development
APP_VERSION=1.0.0
APP_URL=https://chloris-garden.vercel.app
GITHUB_REPOSITORY_URL=https://github.com/ChlorisGarden/ChlorisGarden


# ============================================================
# FRONTEND CONFIG
# React + Vite membaca variable yang diawali VITE_
# ============================================================
VITE_APP_NAME=ChlorisGarden
VITE_API_BASE_URL=http://localhost:3000
VITE_ML_SERVICE_URL=http://localhost:8000
VITE_FRONTEND_URL=http://localhost:5173


# ============================================================
# BACKEND CONFIG
# Node.js + Express
# ============================================================
NODE_ENV=development
PORT=3000

CLIENT_URL=http://localhost:5173
CLIENT_PRODUCTION_URL=https://chloris-garden.vercel.app

JWT_SECRET=
JWT_EXPIRES_IN=7d

RESET_PASSWORD_SECRET=
RESET_PASSWORD_EXPIRES_IN=1h


# ============================================================
# DATABASE CONFIG
# Isi sesuai database yang dipakai.
# Jangan isi credential asli di file .env.example.
# ============================================================

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PostgreSQL langsung, jika dipakai
DATABASE_URL=


# ============================================================
# FILE STORAGE CONFIG
# Untuk gambar upload, foto profil, dan hasil scan.
# ============================================================

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# Supabase Storage, jika dipakai
SUPABASE_STORAGE_BUCKET=

MAX_UPLOAD_SIZE_MB=10


# ============================================================
# EMAIL / SMTP CONFIG
# Untuk forgot password / reset password.
# ============================================================
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ChlorisGarden
SMTP_FROM_EMAIL=


# ============================================================
# ML SERVICE CONFIG
# FastAPI / service prediksi model
# ============================================================
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000
ML_PREDICT_ENDPOINT=/predict

MODEL_PATH=./ml-service/models/plant_disease_v1.keras
CLASS_NAMES_PATH=./ml-service/models/class_names.json

MODEL_INPUT_WIDTH=224
MODEL_INPUT_HEIGHT=224
MIN_CONFIDENCE_THRESHOLD=0.60


# ============================================================
# DEPLOYMENT CONFIG
# Isi saat deploy jika diperlukan.
# ============================================================
VERCEL_URL=
STREAMLIT_PUBLIC_URL=
BACKEND_PUBLIC_URL=
ML_SERVICE_PUBLIC_URL=


# ============================================================
# SECURITY NOTES
# ============================================================
# Jangan pernah mengisi file .env.example dengan:
# - Password asli
# - Token API asli
# - JWT secret asli
# - Supabase service role key asli
# - AWS access key asli
#
# File .env harus masuk .gitignore.
# File .env.example aman untuk di-commit karena hanya berisi template.
